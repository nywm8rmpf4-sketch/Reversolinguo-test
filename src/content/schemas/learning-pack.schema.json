{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reversolinguo.app/schemas/learning-pack-v1.json",
  "title": "Reversolinguo LearningPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "pack_version",
    "audience",
    "language_pair",
    "framework",
    "framework_version",
    "cefr_target",
    "inherits_from",
    "themes",
    "entries",
    "sources",
    "status",
    "human_review"
  ],
  "properties": {
    "pack_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "pack_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "audience": { "enum": ["school", "adult", "theme"] },
    "language_pair": { "type": "string", "pattern": "^[a-z]{2,3}-[a-z]{2,3}$" },
    "framework": { "type": "string", "minLength": 1, "maxLength": 120 },
    "framework_version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "school_year": { "type": "string", "pattern": "^\\d{4}-\\d{4}$" },
    "grade": { "enum": ["6e", "5e", "4e", "3e", "seconde", "premiere", "terminale"] },
    "track": { "enum": ["LVA", "LVB", "LVC"] },
    "cefr_target": { "enum": ["PRE-A1", "A1", "A1+", "A2", "A2+", "B1", "B1+", "B2", "B2+", "C1", "C2"] },
    "inherits_from": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" }
    },
    "themes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "role", "priority", "theme"],
        "properties": {
          "entry_id": { "type": "string", "format": "uuid" },
          "role": { "enum": ["core", "reinforcement", "extension", "optional"] },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "introduced_in": { "type": "string", "minLength": 1, "maxLength": 80 },
          "theme": { "type": "string", "minLength": 1, "maxLength": 80 },
          "subtheme": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "status": { "enum": ["draft", "reviewed", "validated", "withdrawn"] },
    "human_review": { "enum": ["NOT_EXECUTED", "PASS", "FAIL", "TIMEOUT"] }
  },
  "allOf": [
    {
      "if": { "properties": { "audience": { "const": "school" } }, "required": ["audience"] },
      "then": { "required": ["school_year", "grade", "track"] }
    }
  ]
}
