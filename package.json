    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^10.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "6.1.1",
